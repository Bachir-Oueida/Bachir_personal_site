# Copy this file to .env.local and fill in the Fastmail app password.
# .env.local stays on this computer. Do not commit it or send it in chat.

# The Fastmail address the website signs in with. Must be on this Fastmail account.
FASTMAIL_USER=

# App password from Fastmail: Settings → Privacy & Security → Manage app passwords and access.
# Use the app password, not the normal Fastmail login password.

# Inbox that receives the form messages.

# Address the message is sent from. Must belong to the same Fastmail account.
